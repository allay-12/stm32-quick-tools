{
  "name": "stm32-quick-tools",
  "displayName": "STM32 Quick Tools",
  "description": "CubeMX Makefile projects: detect USB probes, build, flash, monitor and debug.",
  "version": "0.1.1",
  "publisher": "local-stm32",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Other"],
  "extensionKind": ["ui"],
  "activationEvents": ["workspaceContains:*.ioc"],
  "capabilities": {
    "untrustedWorkspaces": { "supported": false },
    "virtualWorkspaces": { "supported": false }
  },
  "main": "./extension.js",
  "contributes": {
    "commands": [
      { "command": "stm32Quick.refresh", "title": "STM32: 刷新设备" },
      { "command": "stm32Quick.probe", "title": "STM32: 选择下载器" },
      { "command": "stm32Quick.serial", "title": "STM32: 设置串口" },
      { "command": "stm32Quick.build", "title": "STM32: 编译" },
      { "command": "stm32Quick.flash", "title": "STM32: 烧录并运行" },
      { "command": "stm32Quick.monitor", "title": "STM32: 打开或关闭串口监视" },
      { "command": "stm32Quick.debug", "title": "STM32: 断点调试" }
    ]
  },
  "scripts": { "check": "node --check extension.js && node --check hardware.js" }
}
